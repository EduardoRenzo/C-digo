
/* Define as cores reutilizadas em toda a página. */
:root {
    --primaria: #114ed0;
    --primaria-escura: #2616d3;
    --texto: #1e293b;
    --fundo: #eff6ff;
    --borda: #cbd5e1;
}

/* Inclui bordas e espaçamentos no tamanho total dos elementos. */
* {
    box-sizing: border-box;
}

/* Centraliza o conteúdo e aplica o fundo inicial da página. */
body {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1rem;
    color: var(--texto);
    background: linear-gradient(135deg, #dbeafe, var(--fundo));
    font: 1rem/1.5 Arial, sans-serif;
}

/* Estiliza o título principal. */
h1 {
    margin: 0 0 1.5rem;
    color: #1e3a8a;
    text-align: center;
}

/* Cria cartões visuais para os campos e grupos de opções. */
.campo,
fieldset {
    margin-bottom: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, .9);
    border: 1px solid var(--borda);
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(30, 58, 138, .08);
}

.campo label,
fieldset label {
    display: block;
    margin-bottom: .4rem;
    font-weight: 600;
}

/* Padroniza a aparência dos campos de entrada e da lista. */
input[type="text"],
input[type="number"],
select {
    width: 100%;
    padding: .7rem;
    color: var(--texto);
    background: #fff;
    border: 2px solid var(--borda);
    border-radius: 8px;
    font-size: 1rem;
}

/* Destaca o campo que está recebendo a atenção do usuário. */
input:focus,
select:focus {
    outline: 2px solid #93c5fd;
    border-color: var(--primaria);
}

legend {
    padding: 0 .4rem;
    color: #000208;
    font-weight: 700;
}

fieldset label {
    font-weight: normal;
}

input[type="checkbox"] {
    accent-color: var(--primaria);
}

/* Organiza os botões principais lado a lado. */
.acoes {
    display: flex;
    gap: .75rem;
    margin-top: 1.25rem;
}

button {
    flex: 1;
    padding: .75rem 1rem;
    color: #fff;
    background: var(--primaria);
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
    transition: background .2s, transform .2s;
}

button:hover {
    background: var(--primaria-escura);
    transform: translateY(-2px);
}

#btnLimpar {
    color: #0b2ea3;
    background: #bfdbfe;
}

#btnLimpar:hover {
    background: #93c5fd;
}

/* Área onde os dados preenchidos serão exibidos. */
#resultadoTodosDados {
    min-height: 2rem;
    margin-top: 1.25rem;
    padding: 1rem;
    color: #1e3a8a;
    background: #dbeafe;
    border-left: 5px solid var(--primaria);
    border-radius: 8px;
}

#btnFundo {
    display: block;
    width: fit-content;
    margin: 1rem auto 0;
    padding: .35rem .6rem;
    flex: none;
    font-size: .75rem;
}

/* Anima os caracteres ao passar o mouse. */
.letra {
    display: inline-block;
    transition: color .2s ease;
}

.letra:hover {
    color: var(--primaria);
    animation: pular-letra .5s ease;
}

/* Adapta os botões para telas pequenas. */
@media (max-width: 480px) {
    body {
        padding: 1.25rem .75rem;
    }

    .acoes {
        flex-direction: column;
    }
}

/* Animação de movimento das letras. */
@keyframes pular-letra {
    0%, 100% {
        transform: translateY(0) rotate(0);
    }

    35% {
        transform: translateY(-.3em) rotate(-6deg);
    }

    70% {
        transform: translateY(.08em) rotate(5deg);
    }
}
